# Generated by issue-chain-lesr.sh from server-lesr.config.yaml.tmpl -- edit the template.
#
# Live dev config for echelon-server (signet-plugin scripts/dev-live).
# LESR chain: LESR (QVI) -> auth: LESR Auth (Practice LE) -> subunit: LE Subunit (Practice LE)
#             -> le: LE (QVI) -> qvi: QVI (GLEIF External)
# The NI2I hops (auth, subunit) are not tied to the LE holder by keripy, so each node pins its issuers.
schema:
  client_registration:
    schemas:
      - said: "__SCHEMA_LESR__"   # LESR
        issuers: [__QVI_AID__]
        edges:
          auth:
            schema: "__SCHEMA_LESR_AUTH__"   # LESR Authorization
            issuers: [__PRACTICE_AID__]
            edges:
              subunit:
                schema: "__SCHEMA_LE_SUBUNIT__"   # Legal Entity Subunit
                issuers: [__PRACTICE_AID__]
                edges:
                  le:
                    schema: "__SCHEMA_LE__"   # Legal Entity
                    issuers: [__QVI_AID__]
                    edges:
                      qvi:
                        schema: "__SCHEMA_QVI__"   # QVI
                        issuers: [__EXTERNAL_AID__]

  # User authentication credentials
  user_authentication:
    schemas:
      - said: "EJ5u-JKz-_5IotGyHH8vmbLmTq5t2Wlrm14vjU4FKMBI"  # Utah State SEDI HIC Credential
        issuers: []
        # Optional: OOBI URL to fetch schema if not in database
        # oobi: "https://schema-registry.example.com/oobi/EJ5u-JKz-_5IotGyHH8vmbLmTq5t2Wlrm14vjU4FKMBI"

        oidc_claims:
          # Combine first and last name with space
          name: "{{ a.firstName }} {{ a.lastName }}"
          email: "{{ a.email }}"

          # Middle name with conditional (if present)
          full_name: "{{ a.firstName }} {{ a.middleName if a.middleName else '' }} {{ a.lastName }}"

          given_name: "{{ a.firstName }}"
          family_name: "{{ a.lastName }}"
          middle_name: "{{ a.middleName }}"

          # Create username from name parts
          username: "{{ a.firstName }}_{{ a.lastName }}"
          preferred_username: "{{ a.firstName }}_{{ a.lastName }}"
          address: "{{ a.streetAddress }}, {{a.addressLine2 if a.addressLine2 else ''}}, {{ a.city }}, {{ a.state }} {{ a.zipCode }}"
          street_address: "{{ a.streetAddress }}"
          address_line2: "{{ a.addressLine2 }}"
          locality: "{{ a.city }}"
          region: "{{ a.state }}"
          postal_code: "{{ a.zipCode }}"
          phone_number: "{{ a.phoneNumber }}"

          birthdate: "{{ a.dateOfBirth }}"

          sedi_social_security_number: "{{ a.socialSecurityNumber }}"
          sedi_birth_date: "{{ a.birthDate }}"
          sedi_drivers_license_number: "{{ a.driversLicenseNumber }}"
          sedi_drivers_license_state: "{{ a.driversLicenseState }}"

    user_must_chain_to_client: false


onboarding:
  mode: onboarding
  supported_purposes: [TREAT]
  fetch_allowlist: [127.0.0.1]
  purpose_policy:
    TREAT:
      scopes: [read]
      default_scopes: [read]
      grant_types: [authorization_code, refresh_token, client_credentials]
      response_types: [code]
  # Whitelisted QVI -> 200 approved. server-lesr.config.review.yaml has an empty list -> 202 in-review.
  whitelist: __WHITELIST__
